# Copie este arquivo para .env e preencha antes de iniciar o Compose.
APP_DOMAIN=loja.seudominio.com.br
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-unica
SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
BOOTSTRAP_ADMIN_EMAIL=admin@seudominio.com.br
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-com-mais-de-12-caracteres
BOOTSTRAP_ADMIN_NAME=Administrador Paracolor
SESSION_COOKIE_SECURE=true
MAX_UPLOAD_MB=80
MAX_BACKUP_MB=10240
APP_VERSION=1.0.2
# O repositório informado já vem configurado no painel; público não precisa de token GitHub.
GITHUB_REPOSITORY=ricardomartinsdesigner-pixel/Novo-sistema-de-revelacao-paracolor

# Opcional. Pode cadastrar também pelo painel administrativo depois do primeiro acesso.
MERCADO_PAGO_ACCESS_TOKEN=
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CONTACT_EMAIL=
MELHOR_ENVIO_PACKAGE_WIDTH=22
MELHOR_ENVIO_PACKAGE_HEIGHT=6
MELHOR_ENVIO_PACKAGE_LENGTH=30
MELHOR_ENVIO_PACKAGE_WEIGHT=0.4
