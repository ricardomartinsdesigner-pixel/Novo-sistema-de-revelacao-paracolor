{
  "name": "BannerOption",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "material",
        "acabamento"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "price_per_m2": {
      "type": "number"
    },
    "price_fixed": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "kind"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}