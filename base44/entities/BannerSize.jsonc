      "type": "number"
    },
    "height_cm": {
      "type": "number"
    },
    "base_price": {
      "type": "number"
    },
    "price_per_m2": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "width_cm",
    "height_cm",
    "base_price"
  ],
  "rls": {
