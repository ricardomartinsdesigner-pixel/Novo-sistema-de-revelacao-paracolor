{
  "name": "PriceGroup",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "revelacao",
        "polaroid"
      ],
      "enumColors": [
        "blue",
        "pink"
      ]
    },
    "name": {
      "type": "string"
    },
    "size_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "category",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}