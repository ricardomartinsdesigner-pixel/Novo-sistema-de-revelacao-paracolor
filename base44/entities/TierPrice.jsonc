{
  "name": "TierPrice",
  "type": "object",
  "properties": {
    "tier_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "revelacao",
        "polaroid"
      ],
      "enumColors": [
        "blue",
        "pink"
      ]
    },
    "size_id": {
      "type": "string"
    },
    "size_name": {
      "type": "string"
    },
    "unit_price": {
      "type": "number"
    }
  },
  "required": [
    "tier_id",
    "size_id",
    "unit_price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}