{
  "name": "AccountDeletionRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "processado",
        "recusado"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "pendente"
    },
    "requested_at": {
      "type": "string"
    },
    "processed_by": {
      "type": "string"
    },
    "processed_at": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}