{
  "name": "CatalogCategory",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "personalizados",
        "molduras"
      ]
    },
    "name": {
      "type": "string"
    },
    "parent_id": {
      "type": "string",
      "description": "Vazio para categoria principal; ID da categoria para subcategoria."
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "scope",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
