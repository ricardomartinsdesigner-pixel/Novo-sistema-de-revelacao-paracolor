{
  "name": "CustomProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "full_description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price": {
      "type": "number"
    },
    "promo_price": {
      "type": "number"
    },
    "production_days": {
      "type": "number"
    },
    "stock": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "art_approval_mode": {
      "type": "string",
      "enum": [
        "desativada",
        "opcional",
        "obrigatoria"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue"
      ],
      "default": "opcional"
    },
    "photo_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "instructions": {
            "type": "string"
          },
          "position": {
            "type": "string"
          }
        }
      }
    },
    "text_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "max_length": {
            "type": "number"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "price_delta": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "sort": {
      "type": "number"
    },
    "subcategory": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
