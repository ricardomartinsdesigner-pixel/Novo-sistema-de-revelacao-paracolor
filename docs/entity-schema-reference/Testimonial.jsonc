{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "text"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}