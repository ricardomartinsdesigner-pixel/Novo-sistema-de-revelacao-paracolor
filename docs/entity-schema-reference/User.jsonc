{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "phone": {
      "type": "string",
      "description": "WhatsApp / telefone informado no cadastro"
    },
    "address": {
      "type": "string",
      "description": "Endereço completo informado no cadastro (opcional)"
    },
    "professional_pricing": {
      "type": "boolean",
      "default": false,
      "description": "Acesso à tabela profissional de revelação, concedido pelo administrador."
    },
    "allow_pickup_payment": {
      "type": "boolean",
      "default": false,
      "description": "Permite ao fotógrafo profissional pagar no balcão ao retirar o pedido."
    }
  },
  "required": [
    "role"
  ]
}
